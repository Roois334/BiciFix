# Copia este archivo como .env y llena los valores reales
# NUNCA subas el archivo .env a GitHub

SECRET_KEY=cambia-esto-por-una-clave-segura-larga

# Datos de conexión MySQL (Filess.io los proporciona)
MYSQL_HOST=tu-host.filess.io
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_contraseña
MYSQL_DB=tu_base_de_datos
MYSQL_PORT=3306
